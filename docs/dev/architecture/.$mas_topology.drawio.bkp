        <mxCell id="5V1FQFH7SXDGshUV2N2L-59" value="Нет" style="text;html=1;whiteSpace=wrap;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
