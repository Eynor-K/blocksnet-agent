        <mxCell id="5V1FQFH7SXDGshUV2N2L-58" value="План окончен?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" parent="1" vertex="1">
