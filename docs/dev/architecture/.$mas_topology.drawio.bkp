        <mxCell id="Sl1e6P3U5O9JaidQcmh4-20" value="&lt;b style=&quot;font-family: &amp;quot;Open Sans&amp;quot;, sans-serif; font-size: 14px; white-space-collapse: preserve; background-color: rgb(153, 205, 185);&quot;&gt;Замечания/Проблемы&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#99CDB9;dashed=1;dashPattern=8 8;strokeWidth=1;strokeColor=#5A8978;" parent="4Fqh7MRQ7A0I3CoHcmDp-1" vertex="1">
          <mxGeometry x="137.5" width="170" height="24.98" as="geometry" />
        </mxCell>
        <mxCell id="4Fqh7MRQ7A0I3CoHcmDp-3" value="" style="group" parent="1" vertex="1" connectable="0">
          <mxGeometry x="3200" y="1722.5" width="445" height="200" as="geometry" />
        </mxCell>
        <mxCell id="Sl1e6P3U5O9JaidQcmh4-12" value="&lt;p style=&quot;box-sizing: border-box; margin: 0.5em 0px 0px; width: 397.333px; line-height: 20px; word-break: break-word; orphans: 2; text-indent: 0px; widows: 2; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;font face=&quot;Open Sans, sans-serif&quot;&gt;&lt;span style=&quot;font-size: 14px; white-space-collapse: preserve;&quot;&gt;Как&amp;nbsp;пользователь, который тестирует pipeline, я хочу, чтобы метод&amp;nbsp;CalculateObjectEffects&amp;nbsp;возвращал меньше данных (сейчас это от ~200 000 до ~1 500 000 токенов на один вызов), чтобы&amp;nbsp;не переполнять контекст БЯМ. Если нужны все данные для ответа — тогда нужно ваше подтверждение.&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" style="text;whiteSpace=wrap;html=1;strokeColor=#6A9A88;dashed=1;dashPattern=8 8;fillColor=#99CDB9;align=left;" parent="4Fqh7MRQ7A0I3CoHcmDp-3" vertex="1">
          <mxGeometry y="30.5" width="445" height="129.5" as="geometry" />
        </mxCell>
        <mxCell id="Sl1e6P3U5O9JaidQcmh4-19" value="&lt;b style=&quot;font-family: &amp;quot;Open Sans&amp;quot;, sans-serif; font-size: 14px; white-space-collapse: preserve; background-color: rgb(153, 205, 185);&quot;&gt;Замечания/Проблемы&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#99CDB9;dashed=1;dashPattern=8 8;strokeWidth=1;strokeColor=#5A8978;" parent="4Fqh7MRQ7A0I3CoHcmDp-3" vertex="1">
